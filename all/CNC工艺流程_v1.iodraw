        <mxCell id="p03-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P03&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p03-n5-t" value="&lt;b&gt;一、打点主流程：一夹所有孔先打点&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="138" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p03-n6-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;01 孔集合&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;单面 / 盲 / 通；不分精孔/牙孔，气孔也打&lt;br&gt;球面单独（DR-02）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p03-n7-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;02 打点刀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;铝：D4.0倒角刀 6000/500&lt;br&gt;钢：Z4.0中心钻 2000/100&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="264" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p03-e1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p03-n6-proc" target="p03-n7-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p03-n8-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;03 深度&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;普通 1.2；Ø＜2.4→Ø/2；孔深＜1.2→深−0.1&lt;br&gt;Z4.0中心钻 → −1.0&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
