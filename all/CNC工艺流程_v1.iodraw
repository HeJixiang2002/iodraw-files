        <mxCell id="p08-n89-cell" value="0.6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="1070" y="796" width="140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n90-cell" value="3mm 内牙孔走 0.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="1210" y="796" width="430" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n91-cell" value="1.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="828" width="100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n92-cell" value="高&gt;0.8 且深&gt;1.9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="140" y="828" width="330" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n93-cell" value="D4.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="470" y="828" width="150" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n94-cell" value="11000/2500" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="620" y="828" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n95-cell" value="−1.0 / −1.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="810" y="828" width="260" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n96-cell" value="1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="1070" y="828" width="140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n97-cell" value="分两道 0.4→1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="1210" y="828" width="430" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n98-t" value="&lt;b&gt;五、三类倒角：普通 / 爬面 / 成型刀&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="870" width="1600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08-n99-C-01" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;① 普通倒角&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;平面边/45°；无模型倒角按 h；有模型倒角按 s×h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;内外：&lt;/b&gt;内轮廓优先、外轮廓其次；6 档相同，材料侧/边界分开给&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;刀：&lt;/b&gt;D4.0 / D2.0；D4 失败回退 D2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;6 档；实际倒角 0.15/0.2/0.4/0.6/1.0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特殊：&lt;/b&gt;牙孔 0.2/0.6；小孔 D2 0.15；颜色侧壁走刀补&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;选刀表见上；内/外都有&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="900" width="510" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p08-n100-C-02" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;② 爬面倒角&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;触发：&lt;/b&gt;s≥1.1；曲面/斜面/融合面；R＜0.01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;分组：&lt;/b&gt;ClassfyFacesZeroDist；面积＜0.7 跳过&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗：&lt;/b&gt;arc_D&amp;gt;6 且 h/w&amp;gt;2.99 且 minRad&amp;gt;2.99 → D6粗；h/w&amp;gt;1.499 → D4平&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精：&lt;/b&gt;arc_D&amp;gt;5 且 minRad&amp;gt;1.5 且 h/w&amp;gt;2.01 → D4.0R0.2；否则 D2.0R0.2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;刀轨：&lt;/b&gt;needFaces 空且无近水平 → Level；否则 SurfaceContour&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;曲面/斜面；钢虎钳粗刀不同&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="560" y="900" width="510" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p08-n101-C-03" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;③ 成型刀倒角&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;R 角/成型轮廓；R＜0.01 爬面；R≥0.01 成型刀&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗：&lt;/b&gt;R&amp;gt;2.0 先用 D6.0粗刀开粗&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;刀：&lt;/b&gt;AskFormingCutterName(R)，如 内R0.5D4.0成型刀&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S11000/F2500；默认 −0.4/−0.5；内R0.5 0.0~0.05；底 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;内外：&lt;/b&gt;ClassfyInOutSide 分内/外；材料侧 Left/Inside&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;成型刀一刀；不是 45° 普通倒角&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1080" y="900" width="520" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p08-n102-t" value="&lt;b&gt;六、外形普通倒角的特殊处理（校准版）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="1140" width="1600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08-n103-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;校准版：不打孔（A 面切边）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;三夹倒二夹外形倒角&lt;br&gt;A 面外轮廓做切边&lt;br&gt;刀 D4.0倒角刀_2；外形倒角最后做&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1170" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p08-n104-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;打孔 + 校准版（A 面不切边）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;三夹倒一夹外形倒角&lt;br&gt;A 面有定位孔，A 面不能切&lt;br&gt;B 面外轮廓做切边&lt;br&gt;刀 D4.0倒角刀_2；外形倒角最后做&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="840" y="1170" width="760" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p08-n105-t" value="&lt;font color=&quot;#8F9BB3&quot; style=&quot;font-size:9.5px&quot;&gt;校准版外形倒角单独出 NC / 独立夹位；copyChamferOper；双线框 0 / 0.2；只倒有斜面的倒角。压板必须选校准板，否则三夹程序组创建不了、外形倒角漏。&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1302" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08-n106-t" value="&lt;b&gt;七、牙孔 / 小孔 / 气孔 / 颜色 / 下深&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="1338" width="1600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08-n107-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;牙孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;成立四前提：孔壁无颜色、孔壁高≥2.0、不是沉头/台阶孔、不是通孔&lt;br&gt;孔径表：2.5/2.6/3.3/3.4/4.2/4.3（代码口径，以此为准；文档 3.2 为笔误）&lt;br&gt;浅牙孔（深&amp;lt;3）→ 0.2；深≥3 → 0.6（1.2 档）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1366" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p08-n108-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;小孔 / 气孔 / 颜色 / 下深&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;小孔：孔径&amp;lt;3mm 非牙孔，dist&amp;gt;0.4 且 dist1&amp;gt;0.4 → 0.0 档，D2 倒 0.15&lt;br&gt;气孔：整组跳过；颜色侧壁：校准版深度&amp;lt;0.6 不倒&lt;br&gt;下深保护：dist&amp;lt;0.4 或 dist1&amp;lt;0.4 → 直接排除&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="840" y="1366" width="760" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p08-n109-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;厂区规则（CNC 项目）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;凤岗：l_cut≤B/2 不倒、断两次以上不倒——程序未实现；孔侧壁＞5 不倒——CNC 未实现&lt;br&gt;侨安：非孔类 L＜0.2 不倒——程序未实现；实际按倒角面 Z 向高度分档，不按 L&lt;br&gt;多拼不同厚度：最厚块倒角不设检查边界；倒角组可挂粗加工下，也可独立（两个开关）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1506" width="1600" height="91" as="geometry" />
        </mxCell>
        <mxCell id="p08-n110-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1631" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p08-n111-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1639" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p09" name="09 精加工光底 / 大盲孔底面">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1324" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p09-n1-t" value="09 精加工光面 / 大盲孔底面" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=27;fontColor=#1F3A5F;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="22" width="1100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p09-n2-t" value="2.0：型腔底面 A/B 已统一；光底按型腔底面集合；大盲孔底面 A/B 都用 D10。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5C6B7A;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p09-n3-rule" value="" style="rounded=0;html=1;fillColor=#DCE3EA;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1600" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p09-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P09&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p09-n5-t" value="&lt;b&gt;一、主流程：A/B 同一套光底逻辑&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="138" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p09-n6-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;01 面集&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;型腔底面集合&lt;br&gt;A/B 都用；按高度分组、去重&lt;br&gt;大盲孔底面单独处理&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p09-n7-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;02 选刀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;max(最大内切圆直径, 最大可通行宽度) − 2×侧壁余量&lt;br&gt;按刀径取刀，取真实刀径&lt;br&gt;≥6 或 ＜1.5 → D6.0&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="172" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p09-e1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p09-n6-proc" target="p09-n7-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p09-n8-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;03 光底&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;首面先做；刀路覆盖检查 排除覆盖&lt;br&gt;剩余面逐个做&lt;br&gt;A/B 同循环&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="800" y="172" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p09-e2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p09-n7-proc" target="p09-n8-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p09-n9-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;04 大孔底&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ø≥20 盲孔底面&lt;br&gt;A/B 都用 D10平刀&lt;br&gt;底部余量 0，精加工组&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1180" y="172" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p09-e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p09-n8-proc" target="p09-n9-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p09-n10-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;A/B 统一&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A、B 都用一夹/二夹光面流程&lt;br&gt;同一份 型腔底面集合；同高分组、去重&lt;br&gt;B 面不再单独分组；A/B 同循环&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="300" width="780" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p09-n11-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;选刀公式&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;计算刀径 = max(最大内切圆直径, 最大可通行宽度) − 2×侧壁余量&lt;br&gt;侧壁余量：压板 0.1 / 虎钳 0.3（A/B 同一口径）&lt;br&gt;按刀径取刀：先算计算刀径，再取真实刀径&lt;br&gt;计算刀径 ≥6 或 ＜1.5 → D6.0平刀&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="840" y="300" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p09-n12-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;参数 / 程序组&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;底部余量 = 0；以最大内轮廓作检查边界&lt;br&gt;精加工组 / 精加工阶段&lt;br&gt;转速/进给：刀径≤4 用 小区域精加工，＞4 用精加工参数&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="450" width="780" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p09-n13-t" value="&lt;b&gt;二、特征卡：A/B 光底 / 大盲孔底 / 预留&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8F9BB3&quot;&gt;　A/B 已统一，不再拆两张卡&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=14;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="600" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p09-n14-DR-01" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-01 型腔光底（A/B 统一）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;面集：&lt;/b&gt;型腔底面集合；A/B 都用；按高度分组、去重&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;max(最大内切圆直径, 最大可通行宽度) − 2×侧壁余量；压板 0.1 / 虎钳 0.3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;兜底：&lt;/b&gt;≥6 或 ＜1.5 → D6.0平刀；其余按真实刀径&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;底部余量 0；最大内轮廓；≤4 小区域精加工，＞4 精加工参数&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;覆盖：&lt;/b&gt;首面做刀路覆盖检查，排除已覆盖；失败面重做&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;A/B 共用一套面集和选刀，不再出现 B 面固定 D6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：TestFaceMilling_v2 L832–1128&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="636" width="780" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p09-n15-DR-04" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-04 大盲孔底面（Ø≥20）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;面集：&lt;/b&gt;Ø≥19.99999；底面为平面；进 大盲孔底面集合&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;刀：&lt;/b&gt;A/B 都用 D10平刀（按 D10 取精加工刀）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;转速/进给取粗加工 D10.0平刀参数；底部余量 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;组：&lt;/b&gt;精加工组 / 精加工阶段&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;结论：&lt;/b&gt;A/B 统一 D10；不再是 A D6、B 按面分析&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：A L960–976；B L1110–1126&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="840" y="636" width="760" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p09-n16-DR-07" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-07 预留：新增分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;用途：&lt;/b&gt;旧卡无法覆盖的新光底分支&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;写法：&lt;/b&gt;面集 → 选刀 → 参数/组 → 特例 → 为什么&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;流程：&lt;/b&gt;复制 → 改编号 → 00 页登记 → 评审 → 并入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;提醒：&lt;/b&gt;先查 A/B 统一、大孔底、预留三类&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;图片位：右上 120×80，贴现场/刀路截图&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="876" width="1600" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p09-n17-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;边界 / 统一口径&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A/B 已统一：同一面集、同一选刀公式、同一程序组类型。&lt;br&gt;大盲孔底面 A/B 都 D10；P05 平面铣光底与本页面铣光底可能重复，暂按大孔做两次，不合并。&lt;br&gt;特殊型腔侧壁 → P06；曲面/斜面爬面 → P08；本页只做光底。&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1116" width="1600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p09-n18-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1250" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p09-n19-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1258" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
