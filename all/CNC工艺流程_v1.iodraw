          <mxGeometry x="40" y="1966" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p02b-n39-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
