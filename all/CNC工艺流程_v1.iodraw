        <mxCell id="p08-n85-cell" value="牙孔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="140" y="796" width="330" height="32" as="geometry" />
