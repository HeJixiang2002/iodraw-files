          <mxGeometry x="620" y="796" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p08-n88-cell" value="−0.6 / −1.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="810" y="796" width="260" height="32" as="geometry" />
