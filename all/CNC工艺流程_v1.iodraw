        <mxCell id="p08-n83-cell" value="小孔 / 圆弧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
