        </mxCell>
        <mxCell id="p03-e2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p03-n7-proc" target="p03-n8-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p03-n9-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;04 生成&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HOLE_DRILLING + NXHOLE；点=孔XY+体顶Z&lt;br&gt;最短路径；一夹 DrillCenter 组&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p03-e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p03-n8-proc" target="p03-n9-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p03-n10-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;点位置 / 安全&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;点 = 孔 XY + 体顶 Z&lt;br&gt;TopOffset 3.0；安全距离 20&lt;br&gt;特征按最短路径排序&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="172" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p03-n11-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;深度公式&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;普通：1.2 mm&lt;br&gt;Ø＜2.4：Ø/2&lt;br&gt;孔深＜1.2：孔深−0.1&lt;br&gt;Z4.0中心钻：−1.0&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1040" y="172" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p03-n12-mech" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;球面（仅 A 面）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;按 Ø：3→D3R1.5、4→D4R2、其余 D2R1 球头刀&lt;br&gt;S6000/F500；点=球心XY+球面顶Z&lt;br&gt;深度=球面高度；单独成序&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#8A6FB0;strokeWidth=1.2;fontColor=#402E5C;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="310" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p03-n13-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;定位孔触发（对外接口）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;m_bNeedLoactingHole = 是否带定位孔打点&lt;br&gt;A 面：首件（indexMoveBody=0）&lt;br&gt;B 面：仅压板（fixture=0）；虎钳不需要&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="1040" y="310" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p03-n14-t" value="&lt;b&gt;二、A/B 关系：只看是否贯穿&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="548" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p03-n15-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;一夹&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;所有模型孔打点&lt;br&gt;用于锁螺丝定位&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="582" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-n16-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;二夹 · 虎钳&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;贯穿孔不打（一夹已贯穿）&lt;br&gt;盲孔/单面孔照打&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="440" y="582" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-n17-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;二夹 · 压板&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;一夹未贯穿&lt;br&gt;二夹全部打（含通孔）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="840" y="582" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-n18-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;定位孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;压板二夹要打&lt;br&gt;（垫板可能移动/更换）&lt;br&gt;虎钳夹毛坯底部，不打&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1240" y="582" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-n19-t" value="&lt;b&gt;三、特征卡：普通孔 / 球面 / 定位孔&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8F9BB3&quot;&gt;　只保留这三张，二夹差异写在普通孔卡内&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=14;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="720" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p03-n20-DR-01" value="&lt;b&gt;DR-01 普通孔打点（单面 / 盲 / 通）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;单面 / 盲 / 通；一夹全部；不分精孔/牙孔/气孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;铝 D4.0倒角刀 6000/500；钢 Z4.0中心钻 2000/100&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;点=孔XY+体顶Z；TopOffset 3.0；安全 20；最短路径&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;普通 1.2；Ø＜2.4→Ø/2；孔深＜1.2→深−0.1；Z4.0→−1.0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;虎钳二夹：通孔不打点；盲/单面打点 压板二夹：一夹未贯穿，全部打点（含通孔）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;打点用于锁螺丝定位；虎钳一夹已贯穿，压板未贯穿所以要重打&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L1693 / L8531；CreateCenterDrlling L9284&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="758" width="510" height="224" as="geometry" />
        </mxCell>
        <mxCell id="p03-n21-DR-02" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-02  球面打点（仅 A 面）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;球面；按 Ø 分组（3/4/其他）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;Ø3→D3R1.5；Ø4→D4R2；其余 D2R1 球头刀&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S6000/F500；点=球心XY+球面顶Z&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;深度=球面高度；TopOffset 3.0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;单独成工序；不与平面孔混排；B 面不做&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;球面法向变化，用球刀仿形打点&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：CreateSphericalDrlling L20912；Commit L1695&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="758" width="510" height="224" as="geometry" />
        </mxCell>
        <mxCell id="p03-n22-DR-03" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-03  定位孔打点（m_bNeedLoactingHole）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;m_bNeedLoactingHole=true：程序对外接口，是否带定位孔打点&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;生成：&lt;/b&gt;3 个 Ø4 合成通孔；零件外 2 个 Y 侧 + 1 个 X 侧，距边 d=刀径+3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;程序组：&lt;/b&gt;A：打点→DrillCenter、钻孔→Drill；B：打点/钻孔→二夹面铣组&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;打点/钻孔：&lt;/b&gt;D4/Z4 打点 6000/500 或 2000/100；Z4.0 钻孔 2500/300 或 1100/80&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;压板二夹要打（垫板可能移动/更换，锁螺丝要重打）；虎钳不打&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;压板二夹底部垫板可能移动/更换；虎钳夹毛坯底部，不需要&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：CreateLocatingHole L17333；BFace L17372&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0504D;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="758" width="510" height="224" as="geometry" />
        </mxCell>
        <mxCell id="p03-n23-DR-04" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-04  预留：新增分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;用途：&lt;/b&gt;旧卡无法覆盖的新打点特征，才用这张卡&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;写法：&lt;/b&gt;判定 → 选刀 → 参数 → 深度 → 特例 → 为什么&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;流程：&lt;/b&gt;复制 → 改编号 → 00 页登记 → 评审 → 并入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;提醒：&lt;/b&gt;先查旧卡；确认是新特征才开卡&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;图片位：右上 120×80，贴现场/刀路截图&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="982" width="510" height="224" as="geometry" />
        </mxCell>
        <mxCell id="p03-n24-t" value="&lt;b&gt;四、定位孔：3 个 Ø4 合成孔，重点是最终挂在哪个程序组&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="1215" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p03-n25-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;创建顺序不重要；最终程序组位置才决定它跟谁一起出 NC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;位置：零件外，2 个在 Y 负侧（X 1/4、3/4），1 个在 X 侧（Y 1/4）；距边 d=刀径+3（6/10）；A/B 镜像&lt;br&gt;程序组：A 面打点→DrillCenter、钻孔→Drill；B 面打点/钻孔→二夹面铣组&lt;br&gt;为什么压板要、虎钳不要：压板二夹底部垫板可能移动/更换，锁螺丝要重新打点；虎钳夹毛坯底部，二夹不需要&lt;br&gt;联动：m_bNeedLoactingHole 还会让一夹面铣跳过开粗（02）、二夹复制/定位（01）；定位孔工序进 excludedOpers&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1249" width="1600" height="126" as="geometry" />
        </mxCell>
        <mxCell id="p03-n26-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;提意见 / 加分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;提意见：引用卡号 DR-xx，按 P00 的模板写“现象 / 触发 / 期望 / 附件”；先在图外登记，评审后统一改图。&lt;br&gt;加分支：P03 只保留 3 张卡；新特征先在 00 页登记，评审通过后再加 DR-04。&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1400" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p03-n27-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1504" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p03-n28-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1512" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p04" name="04 钻孔">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1818" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p04-n1-t" value="04 钻孔" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=27;fontColor=#1F3A5F;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="22" width="1100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p04-n2-t" value="按 1.0 代码背后的工艺逻辑梳理：孔型 × 精/非精 × 平底/沉头；先看匹配/牙孔，再决定是否铣孔。材料默认=铝件，钢件走单独分支。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5C6B7A;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-n3-rule" value="" style="rounded=0;html=1;fillColor=#DCE3EA;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1600" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p04-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P04&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p04-n5-t" value="&lt;b&gt;一、一夹主流程：先分流，再定刀 / 定深&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="138" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p04-n6-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;01 识别与标记&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;孔型：盲 / 通 / 单面；形状：底面有内轮廓=沉头，无=平底&lt;br&gt;颜色：同色=非精孔，有颜色=精孔&lt;br&gt;标记：牙孔表（2.05/2.5/3.3/4.2）、气孔&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p04-n7-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;02 分流：是否匹配&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;匹配钻头 或 牙孔指定刀 → 一夹钻 + 二夹钻（通孔不铣；盲孔 1.0 仍铣）&lt;br&gt;不匹配 → 一夹钻 + 铣孔（P05）&lt;br&gt;Ø&amp;gt;5.5 → 最大 5.5，先钻 5.5 再铣&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="264" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p04-e1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p04-n6-proc" target="p04-n7-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p04-n8-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;03 定刀 / 定参 / 定深&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;普通/精孔见右；牙孔见 DR-02/DR-05&lt;br&gt;参数取表值，特殊特征覆写&lt;br&gt;深度按孔型×装夹（见右）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="356" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p04-e2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p04-n7-proc" target="p04-n8-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p04-n9-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;04 生成&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Drll 组；同径同组；精孔单独&lt;br&gt;最短路径排序&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p04-e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p04-n8-proc" target="p04-n9-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p04-n10-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;普通孔选刀（同色 / 非精孔）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;① 精确匹配 → 直接用&lt;br&gt;② 无 → 更小最近 + 铣&lt;br&gt;③ Ø&amp;gt;5.5 → 5.5 预钻 + 铣&lt;br&gt;④ 牙孔 → 指定刀&lt;br&gt;注：1.0 盲孔仍铣；通孔匹配/牙孔不铣&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="172" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p04-n11-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;精孔选刀（有颜色）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;常规钻头；取 ≤孔径 的最近一把&lt;br&gt;正好同径 → 降一号（如 5.5→5.1、4.2→4.0、3.4→3.3）&lt;br&gt;沉头 → 不换刀；平底 → 才降一号&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1040" y="172" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p04-n12-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;参数：表值为主，特殊特征覆写&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;S/F/Q 来自刀具表（粗加工组）&lt;br&gt;牙孔/预钻用专用值：2.05/2.5 铝 2500/200、钢 2500/60；3.3 铝 2500/300、钢 2200/70&lt;br&gt;Z5.5 预钻：铝 1800/500、钢 1500/80&lt;br&gt;Q = 粗加工下刀量；首刀 1000；进/退刀 rapid&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="350" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p04-n13-mech" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;深度：按孔型 × 装夹&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;盲孔：孔深+顶−孔口−刀尖（斜面修正）&lt;br&gt;通孔：虎钳 体高+2；压板 体高−0.2−刀尖；二夹 刀尖+0.1（孔口距≤3 才钻）&lt;br&gt;单面：盲孔同盲；贯通/虎钳 孔深+顶−孔口+1&lt;br&gt;定位：二夹 3；虎钳 体高+2；压板 体高+0.5&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#8A6FB0;strokeWidth=1.2;fontColor=#402E5C;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1040" y="350" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p04-n14-t" value="&lt;b&gt;二、A/B 关系与二夹：同一特征还是两个特征&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="548" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p04-n15-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;盲孔 · A/B 独立&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;两个特征，各自加工&lt;br&gt;二夹在 B 面单独钻；1.0 仍会铣孔（同色牙孔除外）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="582" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p04-n16-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;通孔 · A/B 联动&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;同一特征，两夹配合&lt;br&gt;虎钳/已通 → 只倒角；压板 → 孔口距 B 面≤3 才补钻（刀尖+0.1）；&amp;gt;3 只倒角&lt;br&gt;薄板（B 面）Ø&amp;gt;1.5 且毛坯≤4 → 不钻&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="440" y="582" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p04-n17-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;单面孔 · 看贯穿&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;贯通 → 按通孔联动&lt;br&gt;盲孔 → 按盲孔独立&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="840" y="582" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p04-n18-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;牙孔 · 指定刀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;一夹钻 + 二夹钻，不铣&lt;br&gt;深度按孔型（盲/通/单面）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1240" y="582" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p04-n19-t" value="&lt;b&gt;三、特征卡：先找卡号，再看卡内 6 行&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8F9BB3&quot;&gt;　盲孔按“沉头 / 牙孔 / 非牙孔”分三张；通孔、牙孔通、单面各一张&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=14;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="718" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p04-n20-DR-01" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-01  沉头孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;盲孔；底面有内轮廓；Ø 像牙孔也按沉头（不是牙孔）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;麻花钻表取“小于孔的最大一把”（降一号）；有颜色也不换刀&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S/F/Q 表值；Drill,Deep&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;孔深+顶−孔口−刀尖；台阶面不钻到底&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；二夹单独钻；不铣（P05 要铣台阶）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;沉头有台阶，钻头不能顶到底；台阶由铣孔完成&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 Commit L1813–1827&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="754" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n21-DR-02" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-02  牙孔（盲孔）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;盲孔；底面无内轮廓；Ø 2.05/2.5/3.3/4.2（钻孔/铣孔表）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;2.05→2.1、2.5→2.6、3.3→3.4（故意大于孔）；4.2→4.2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;专用 S/F：铝 2500/200、钢 2500/60；3.3 铝 2500/300、钢 2200/70&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;孔深+顶−孔口−刀尖&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；二夹单独钻；不铣（含精孔）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;牙孔精度要求不高；指定刀；再铣伤牙&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 Commit L1770–1788 / L1789&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="754" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n22-DR-03" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-03  非牙孔盲孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;盲孔；底面无内轮廓；Ø 不在牙孔表&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;同色→精确/更小最近；有颜色→常规钻头 ≤最近，同径降一号&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S/F/Q 表值；精孔用精孔参数&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;孔深+顶−孔口−刀尖；Ø＜1.01 且深≥2.01 → 不扣刀尖&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；二夹单独钻&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;同色无匹配→+铣；有颜色→精铣+刀补&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;普通盲孔按匹配；精孔留余量给精铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 Commit L1789 / L1879&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="754" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n23-DR-04" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-04  通孔（非牙孔）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;通孔；Ø 不在牙孔表&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;同色→精确/更小最近；有颜色→常规钻头 ≤最近，同径降一号&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S/F/Q 表值；Drill,Deep&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;虎钳 体高+2；压板 体高−0.2−刀尖；二夹 刀尖+0.1（孔口距≤3 才钻）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;同一特征联动；虎钳/已通→只倒角；压板→孔口距 B 面≤3 才补钻&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;无匹配→+铣；有颜色→精铣+刀补；薄板 Ø&amp;gt;1.5 且毛坯≤4 → B 不钻&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;压板不能钻穿；通孔 A/B 联动&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 CreateDrilling L2126；Commit L8622&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="970" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n24-DR-05" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-05  牙孔（通孔）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;通孔；Ø 2.05/2.5/3.3/4.2（钻孔/铣孔表）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;2.05→2.1、2.5→2.6、3.3→3.4；4.2→4.2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;专用 S/F 同 DR-02&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;虎钳 体高+2；压板 体高−0.2−刀尖；二夹 刀尖+0.1（孔口距≤3 才钻）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;同一特征联动；虎钳/已通→只倒角；压板→孔口距 B 面≤3 才补钻&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;有颜色也不铣；沉头即使 Ø 像牙孔也走 DR-01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;牙孔精度要求不高；通孔 A/B 联动&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 Commit L1770–1788 / L8622&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="970" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n25-DR-06" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-06  单面孔（贯穿 / 盲）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;单面孔；先判断是否贯穿&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;选刀：&lt;/b&gt;贯通 → 同通孔；盲 → 同盲孔（牙孔按表）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;参数：&lt;/b&gt;S/F/Q 表值；Drill,Deep&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;深度：&lt;/b&gt;盲同盲孔；贯通/虎钳 孔深+顶−孔口+1；Ø＜1.01 且深≥2.01 → 不扣刀尖&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;贯通 → 按通孔联动；盲 → 按盲孔独立&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;单面孔背面没有孔底；小孔多钻保证贯通&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：1.0 CreateDrilling L2284 / L2356&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="970" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n26-DR-07" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-07  预留：新增分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;用途：&lt;/b&gt;旧卡无法覆盖的新孔特征，才用这张卡&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;写法：&lt;/b&gt;判定 → 选刀 → 参数 → 深度/A-B → 特例 → 为什么&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;流程：&lt;/b&gt;复制 → 改编号 → 00 页登记 → 评审 → 并入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;提醒：&lt;/b&gt;先查旧卡。牙孔/沉头/非牙孔三类优先归类&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;图片位：右上 120×80，贴现场/刀路截图&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1186" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="p04-n27-t" value="&lt;b&gt;四、全局过滤：这些孔不建工序 / 不进钻孔&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="1414" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p04-n28-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;先过滤，再选刀——否则会在空刀、断刀上浪费参数&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;气孔：盲孔 Ø≤5.5 且非精孔 → 跳过；通孔 → 跳过&lt;br&gt;孔形：孔面不相邻 / 近同轴孔 / 深度不足（孔深−刀尖≤0）→ 跳过&lt;br&gt;二夹：一夹已覆盖 [0, 高−0.1] 的通孔 → 只倒角，不再钻&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1448" width="1600" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p04-n29-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;代码锚点以 1.0 为准（Commit / CreateDrilling）。1.0 兼容：B 面 5.51、单面 2.05→Z2.05 属历史写法，本图按 5.5 / Z2.1 统一。&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1568" width="1600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p04-n30-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;1.0 铣孔现状：盲孔 A/B 都会建铣孔工序（同色牙孔除外）；通孔在匹配/牙孔时跳过。工艺目标“匹配不铣”待收敛。&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1588" width="1600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p04-n31-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;提意见 / 加分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;提意见：引用卡号 DR-xx，按 P00 的模板写“现象 / 触发 / 期望 / 附件”；先在图外登记，评审后统一改图。&lt;br&gt;加分支：复制 DR-07 预留卡 → 编号顺延 → 写清判定/选刀/参数/深度/A-B/为什么 → 评审后并入本页。&lt;br&gt;不受理：单图改刀、无样本、只说“不好用”。&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1620" width="1600" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p04-n32-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1744" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p04-n33-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1752" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p05" name="05 铣孔">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1956" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p05-n1-t" value="05 铣孔" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=27;fontColor=#1F3A5F;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="22" width="1100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p05-n2-t" value="按 1.0：非牙孔分精/非精 × 平底/沉头/通孔；牙孔（含精孔）不铣；沉头要铣台阶锥尖。材料默认=铝件。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5C6B7A;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p05-n3-rule" value="" style="rounded=0;html=1;fillColor=#DCE3EA;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1600" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p05-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P05&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p05-n5-t" value="&lt;b&gt;一、主流程：先粗铣，再精铣&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="138" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p05-n6-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;01 孔集&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A 面：盲孔 + 通孔&lt;br&gt;B 面：只盲孔（通孔 A 已铣通）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p05-n7-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;02 粗铣&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;非牙孔：盲 Ø0.5~12、通 Ø≥0.5&lt;br&gt;Ø&amp;gt;12 走大孔；牙孔/单面/二夹通孔不铣&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="264" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p05-e1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p05-n6-proc" target="p05-n7-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-n8-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;03 精铣&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;光侧 + 光底&lt;br&gt;A 盲/通、B 盲；牙孔不铣&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="356" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p05-e2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p05-n7-proc" target="p05-n8-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-n9-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;04 输出&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;粗/光底→铣孔组；光侧→精加工组&lt;br&gt;刀补号；同径同组&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p05-e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p05-n8-proc" target="p05-n9-proc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-n10-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;选刀：比较直径 + 分段&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;盲孔：比较直径 Ø−1.5&lt;br&gt;通孔：比较直径 Ø−2.0（再小 0.5）&lt;br&gt;分段：4.5~5.5→3.1、2.8~4.5→2.1、1.9~2.8→1.5、1.3~1.9→1.1、≤1.3→0.7&lt;br&gt;取 ≤比较直径 的最大平刀（type=1）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="172" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-n11-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PLANAR：轮廓铣 vs 平面铣（按代码）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;孔壁：≤12 PROFILE；12–20 仍 PROFILE；&amp;gt;20 MILL；钢&amp;gt;30 MILL&lt;br&gt;光底：6＜Ø＜20 全部 MILL（A/B）；Ø≥20 不补，交 P09&lt;br&gt;1.0 CreateHoleMilling_2D(...false,true) 已统一为 MILL&lt;br&gt;注：2.0 对 B 小孔仍 PROFILE，但 2.0 铣孔宏未启用&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1040" y="172" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-n12-mech" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;参数 / 余量&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;粗：小区域粗加工；进给固定 500（稳定设定）&lt;br&gt;部件余量 0.1、底面 0.1；钢 D10 0.15、D17R0.8 0.2&lt;br&gt;精：小区域精加工；侧壁余量 0；颜色孔开刀补&lt;br&gt;光底：小区域粗加工；底余量 0&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#8A6FB0;strokeWidth=1.2;fontColor=#402E5C;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="420" y="350" width="600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p05-n13-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;大孔 / 补底&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;大孔侧壁 Ø&amp;gt;12（A/B 同逻辑）：钢&amp;gt;30→D17R0.8；钢 12–30 / 铝→D10&lt;br&gt;补底只做全底面盲孔：6＜Ø＜20 才补；Ø≤6、Ø≥20 不补&lt;br&gt;12＜Ø＜20→D6.0平刀；6＜Ø≤12→粗刀链下一把小刀；底余量 0&lt;br&gt;Ø≥20 交给 P09 面铣 D10；沉头 / 底面有内环不补&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="1040" y="350" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p05-n14-t" value="&lt;b&gt;二、工序分层：粗加工 / 精加工·光侧 / 光底&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="544" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p05-n15-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;粗加工铣孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;模板：PLANAR_PROFILE（小孔）/ PLANAR_MILL（大孔）｜参数：小区域粗加工、进给 500、侧/底余量 0.1｜程序组：一夹 铣孔 / 二夹 二夹铣孔（RoughHoleMill）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="578" width="1600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p05-n16-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;精加工铣孔 · 光侧&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;模板：PLANAR_MILL｜参数：小区域精加工、侧壁余量 0、颜色孔开刀补｜程序组：一夹 精加工 / 二夹 二夹精加工（FinishHoleMill）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="626" width="1600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p05-n17-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;光底（精加工的一部分，但代码写在粗加工块里）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;模板：6＜Ø＜20 全部 MILL（A/B，1.0 false,true）；Ø≥20 不补（P09）｜参数：6–12 小区域粗加工、12–20 小区域精加工、底余量 0｜程序组：一夹 铣孔 / 二夹 二夹铣孔（跟粗加工走）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="674" width="1600" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p05-n18-t" value="&lt;b&gt;三、组合路径：钻/铣/二夹怎么搭&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="752" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p05-n19-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;匹配 / 牙孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;一夹钻 + 二夹钻&lt;br&gt;不铣孔&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="786" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-n20-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;不匹配（非牙孔）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;一夹钻 + 铣孔&lt;br&gt;二夹钻 / 只倒角&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="570" y="786" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-n21-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;单面 / 二夹通孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;只钻 / 倒角&lt;br&gt;不铣孔&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="1100" y="786" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-n22-t" value="&lt;b&gt;四、特征卡：非精孔 / 精孔 × 平底 / 沉头 / 通孔 + 牙孔&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8F9BB3&quot;&gt;　精孔单独成卡；牙孔（含精孔）不铣&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=14;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="882" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p05-n23-DR-01" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-01  非精孔 · 平底盲孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;非牙孔；同色；底面无内轮廓；A Ø0.5~12，B 粗 Ø1.5~12&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;小区域粗加工；进给 500；PROFILE；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;光底：&lt;/b&gt;6＜Ø＜20 A/B 都 MILL；Ø≥20 不补（P09）；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；B 单独铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;沉头→DR-02；精孔→DR-04；牙孔→DR-07&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;刀小于孔留螺旋下刀；光底清钻尖凸台&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L3892–4029 / B L8765–8977&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="918" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n24-DR-02" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-02  非精孔 · 沉头孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;非牙孔；同色；底面有内轮廓（Ø 像牙孔也算沉头）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;铣台阶/锥尖；PROFILE；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精铣：&lt;/b&gt;PLANAR_MILL（光侧/台阶）；组 精加工&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;不补底；精孔→DR-05&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;沉头台阶和锥尖必须铣出&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L3944/L7163 只跳平底&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="918" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n25-DR-03" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-03  非精孔 · 通孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;A 面通孔；非牙孔；同色&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;PROFILE（≤20）/ MILL（&amp;gt;20）；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精铣：&lt;/b&gt;仅无钻头/颜色/薄板；组 精加工&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A 通后 B 不再铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;匹配钻头且同色可跳过；牙孔→DR-08&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;通孔 A 铣通，B 不重复&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L4091–4176 / L7085–7337&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="918" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n26-DR-04" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-04  精孔 · 平底盲孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;非牙孔；有颜色；底面无内轮廓&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;小区域粗加工；PROFILE；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精铣：&lt;/b&gt;小区域精加工；PLANAR_MILL；侧壁余量 0；刀补；组 精加工&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;光底：&lt;/b&gt;6＜Ø＜20 A/B 都 MILL；Ø≥20 不补（P09）；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；B 单独&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;沉头→DR-05；牙孔→DR-07&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L7085–7337 / B L10008–10122&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1148" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n27-DR-05" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-05  精孔 · 沉头孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;有颜色；沉头（底面有内轮廓）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;铣台阶/锥尖；组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精铣：&lt;/b&gt;PLANAR_MILL（光侧/台阶）+ 刀补；组 精加工&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;不补底；Ø 像牙孔也算沉头&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;精孔沉头也要铣台阶/锥尖&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L3944/L7163 只跳平底&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="1148" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n28-DR-06" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-06  精孔 · 通孔&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;A 面通孔；有颜色；非牙孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;粗铣：&lt;/b&gt;组 铣孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;精铣：&lt;/b&gt;颜色/无钻头/薄板；组 精加工；刀补&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A 通后 B 不再铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;精孔牙孔不在此卡；牙孔→DR-08&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;A 面铣通，B 不重复&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L7085–7337&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="1148" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n29-DR-07" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-07  牙孔 · 平底盲孔（不铣）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;牙孔 Ø 2.05/2.5/3.3/4.2（钻孔/铣孔表）；平底；精孔也不铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;处理：&lt;/b&gt;粗/精/光底都跳过；钻头直接成孔&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;A/B 独立；B 单独钻&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;沉头即使 Ø 像牙孔→DR-02/DR-05（不是牙孔）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;牙孔精度要求不高，底孔已到位；再铣伤牙&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L3944（粗跳）/ L7163（精跳）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1378" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n30-DR-08" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-08  牙孔 · 通孔（不铣）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;判定：&lt;/b&gt;牙孔 Ø 2.05/2.5/3.3/4.2（钻孔/铣孔表）；通孔；精孔也不铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;处理：&lt;/b&gt;A 压板留 0.2（不钻穿）；B 孔口距 B 面≤3 才破口（刀尖+0.1）；&amp;gt;3 只倒角；不铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;A/B：&lt;/b&gt;同一特征联动；A 通后 B 不重复&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;特例：&lt;/b&gt;沉头→DR-02/DR-05；精孔牙孔也不铣&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#5B4778&quot;&gt;&lt;b&gt;为什么：&lt;/b&gt;通孔由钻头直接成；牙孔精度要求不高&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;代码：Commit L4109/L7303 跳过；B L8622&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="570" y="1378" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n31-DR-09" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DR-09  预留：新增分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2E5F8A&quot;&gt;&lt;b&gt;用途：&lt;/b&gt;旧卡无法覆盖的新铣孔特征，才用这张卡&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#2F6B41&quot;&gt;&lt;b&gt;写法：&lt;/b&gt;判定 → 粗/精/光底 → 程序组 → 特例 → 为什么&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;流程：&lt;/b&gt;复制 → 改编号 → 00 页登记 → 评审 → 并入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#A5413B&quot;&gt;&lt;b&gt;提醒：&lt;/b&gt;先查旧卡；精/非精 × 平底/沉头/通孔优先归类&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8F9BB3&quot;&gt;图片位：右上 120×80，贴现场/刀路截图&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;strokeWidth=1.3;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1100" y="1378" width="510" height="214" as="geometry" />
        </mxCell>
        <mxCell id="p05-n32-t" value="&lt;b&gt;五、全局跳过：这些孔不铣&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="1618" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p05-n33-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;先过滤，再选刀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;牙孔（平底/通孔，含精孔）→ 不铣；沉头 → 铣台阶（DR-05/DR-02）；非牙孔 → 正常逻辑&lt;br&gt;气孔（≤5.5 且非精孔）→ 不铣；单面孔 → 只钻；二夹通孔 → 不铣&lt;br&gt;孔面不相邻 → 跳过&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1652" width="1600" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p05-n34-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;提意见 / 加分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;提意见：引用卡号 DR-xx，按 P00 的模板写“现象 / 触发 / 期望 / 附件”；先在图外登记，评审后统一改图。&lt;br&gt;加分支：复制 DR-09 预留卡 → 编号顺延 → 写清判定/粗精/光底/程序组/为什么 → 评审后并入本页。&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1778" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-n35-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1882" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-n36-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1890" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p06" name="06 型腔铣">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1158" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p06-n1-t" value="06 型腔铣" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=27;fontColor=#1F3A5F;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="22" width="1100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p06-n2-t" value="只按 1.0：粗加工分钢件虎钳 / 其他两套选刀；粗/精都是第一刀 + 清角（参考上一把）；彩色型腔走刀补。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5C6B7A;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p06-n3-rule" value="" style="rounded=0;html=1;fillColor=#DCE3EA;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1600" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p06-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P06&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p06-n5-t" value="&lt;b&gt;左侧主流程，右侧写清选刀 / 参数&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="134" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p06-n6-proc" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;① 型腔特征 / 分组&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+Z 平面；去顶面、孔底、遮挡面&lt;br&gt;按高度分组；同高包容重合去重&lt;br&gt;单侧壁：最小直径 −1.99&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#4A78B5;strokeWidth=1.4;fontColor=#1F3A5F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="168" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n7-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;② 开放 / 闭合&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;数外轮廓条数 + 相邻面个数&lt;br&gt;闭合 / 部分开放 / 完全开放&lt;br&gt;两条平行线的开放面 → 不铣&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="280" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n8-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;③ U 型槽？&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4 条边 + U 多曲线 + 深&amp;gt;5（钢虎钳&amp;gt;3）&lt;br&gt;是 → 先点孔 + 钻孔&lt;br&gt;否 → 直接粗加工&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="392" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n9-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;④ 粗加工分支&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;钢件虎钳 → 专用粗加工&lt;br&gt;其他 → 通用粗刀链&lt;br&gt;两套选刀不同，见右&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="504" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n10-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;⑤ 精加工&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;D6 第一刀 → D4 → D3 → D2 → D1.5&lt;br&gt;每级带上一把参考刀&lt;br&gt;上一把失败则下一把不带参考&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="616" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n11-mech" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;⑥ 刀补 / 覆盖&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;有刀补值 → 刀补组&lt;br&gt;全着色侧壁 → 跳过普通精加工&lt;br&gt;刀路覆盖检查 移出覆盖面&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#8A6FB0;strokeWidth=1.2;fontColor=#402E5C;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="728" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-e1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p06-n6-proc" target="p06-n7-case" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p06-n7-case" target="p06-n8-case" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p06-n8-case" target="p06-n9-case" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p06-n9-case" target="p06-n10-param" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4A78B5;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p06-n10-param" target="p06-n11-mech" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-n12-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;特征筛选 / 分组&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;取法向 +Z 的平面；排除顶面、孔底面、被遮挡面&lt;br&gt;按高度分组；同高度去除包容重合的面；每组独立开粗&lt;br&gt;单侧壁型腔（底面 + 1 侧壁）：最小直径按 −1.99 修正&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="440" y="168" width="1120" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n13-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;开放 / 闭合的边界余量&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;闭合：四周都有侧壁 → 全部 −(R/2+1)&lt;br&gt;部分开放：与外轮廓共线的边 0；不共线 −(R/2+1)&lt;br&gt;完全开放：全部 0；两条平行线的开放面 → 不铣（避免空刀）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="440" y="280" width="1120" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p06-n14-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;U 型槽：先点孔 + 钻孔，再进粗刀链&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;长槽 长&amp;gt;3×宽：两端钻，半径=宽/2；短槽：中心钻，半径=宽&lt;br&gt;点孔：D4.0倒角刀；钻孔按 U 槽最小圆弧：&amp;gt;5.49 Z5.5；4.49–5.5 Z4.5；3.39–4.49 Z3.4；2.1–3.39 Z2.1&lt;br&gt;转速/进给取刀具表粗加工；深度＝孔口最高 Z；先钻后铣，避免满刀下切&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="440" y="392" width="1120" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p06-n15-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;钢件虎钳：专用粗加工&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;第一把：能上 D17R0.8 就用 D17R0.8；否则能上 D10 用 D10；否则 D6.0&lt;br&gt;起手链：17→D10→D6→小刀；10→D6→小刀；6→小刀&lt;br&gt;自动选刀：主刀=主开粗 / 保护刀=下一档 / 清角刀=小刀&lt;br&gt;小刀按 最大可通行宽度 / 最小圆角直径&lt;br&gt;分析失败：D10→D6→D4→…→D0.5 固定链（大刀套小刀，不按通行）&lt;br&gt;侧余量：D10 0.15，其余 0.05；参考刀下刀量/2、distance 0.8；无参考 full、1.0&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="440" y="504" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p06-n16-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;其他：通用粗刀链&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;多拼≥18：多拼间距/总厚≥18 → 粗刀径表 含 D10；否则 D6 起&lt;br&gt;自动选刀 → 主刀（主开粗）/ 保护刀（下一档）/ 清角刀（小刀）&lt;br&gt;主刀无参考；保护刀在主刀=D10 或主刀失败时建，参考主刀；清角刀小于参考刀时建，参考上一把&lt;br&gt;只处理分析成功的面；未分析/分析失败的面跳过（默认大刀套小刀只用于成功面）&lt;br&gt;侧余量：D10/D6 0.2，其余 0.1；参考刀下刀量/2、distance 0.8&lt;br&gt;粗底余量 0.1；步距 75%（铝压板）；斜进刀 3°；D10 进刀高 3&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="1010" y="504" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p06-n17-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;精加工：第一刀 + 清角&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;D6.0平刀（第一刀，无参考）→ D4.0平刀（ref D6）→ D3.0（ref D4）→ D2.0（ref D3）→ D1.5（ref D2）&lt;br&gt;上一把失败 → 下一把 referTool=&quot;&quot;（不带参考）；失败刀没有有效刀路/IPW，不能作为参考&lt;br&gt;D4/D3/D2/D1.5 下刀量＝原下刀量/4；侧余量 0.1；底面余量实际 0.01（0.2~0.4 是旧描述）&lt;br&gt;颜色/刀补：走 刀补组；底部余量 仍 0.01；+0.03 是未生效的遗留代码（is_color 未赋值）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="440" y="710" width="1120" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p06-n18-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;刀补 / 覆盖 / 收尾&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;型腔铣刀补只针对有刀补值的型腔：单独 刀补组、刀补号 index、底面 +0.03；侧壁全着色 → 跳过普通精加工&lt;br&gt;刀路覆盖检查：刀路覆盖到的面移出；未覆盖换更小刀继续；已覆盖不再建工序&lt;br&gt;虎钳外轮廓开粗走型腔逻辑（A 面侧 0.2/底 0），见 P07；本页只做型腔&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="440" y="850" width="1120" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p06-n19-note" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;术语&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;可用17R0.8 / 可用D10：该体或机床是否允许 D17R0.8 / D10；多拼≥18：多拼是否允许 D10&lt;br&gt;big / guard / small：主开粗 / 保护刀 / 清角刀；最大可通行宽度、最小圆角直径来自区域分析&lt;br&gt;分析失败：没有 最大可通行宽度/最小圆角直径 可用，退回固定 D10→D6→…→D0.5 的大刀套小刀链&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1;fontColor=#4A5568;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="970" width="1600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p06-n20-rule" value="" style="rounded=0;html=1;fillColor=#E8EDF2;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="1084" width="1600" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-n21-t" value="CNC 自动编程工艺流程图 · v1.1 · 00/02/03/04/05/06/07/08/09 为流程+卡试点 · 维护：工艺组（规则/参数）· 现场（特殊情况的真实样本）· 开发（机制/代码）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=9.5;fontColor=#8F9BB3;" parent="1" vertex="1">
          <mxGeometry x="40" y="1092" width="1600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p07" name="07 轮廓铣">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1286" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p07-n1-t" value="07 轮廓铣" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=27;fontColor=#1F3A5F;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="22" width="1100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p07-n2-t" value="只按 1.0：颜色内轮廓→刀补；无色内轮廓→普通轮廓；外轮廓→虎钳走型腔，压板+定位孔决定 A 切/B 切。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5C6B7A;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p07-n3-rule" value="" style="rounded=0;html=1;fillColor=#DCE3EA;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1600" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p07-n4-t" value="&lt;font color=&quot;#8F9BB3&quot;&gt;P07&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=right;verticalAlign=top;fontSize=11;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="1380" y="32" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p07-n5-t" value="&lt;b&gt;一、先分清三个轮廓来源，不能混&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="138" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p07-n6-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GetBodyShadowOutlineColor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;有色内轮廓；单独存&lt;br&gt;精加工放刀补组（CuttCompen）&lt;br&gt;不参与普通内轮廓的“移除剩余”&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p07-n7-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GetBodyShadowOutline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;无色内轮廓；按 Z 范围分组&lt;br&gt;粗/精走普通轮廓&lt;br&gt;每级带上一把参考刀&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="560" y="172" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p07-n8-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GetBodyShadowOutlineMax&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;外轮廓；虎钳走型腔逻辑&lt;br&gt;压板 + 定位孔决定 A 切 / B 切&lt;br&gt;不是所有外轮廓都走平面轮廓&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="1080" y="172" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p07-n9-t" value="&lt;b&gt;二、外轮廓：虎钳走型腔；压板按定位孔分 A/B 切&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="310" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p07-n10-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;装夹？&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;虎钳 / 压板&lt;br&gt;定位孔有无&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="40" y="344" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p07-n11-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;虎钳：只 A 面切边&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A 面外轮廓走型腔整体开粗：侧 0.2、底 0&lt;br&gt;再 A 面切边修侧壁；不受定位孔控制&lt;br&gt;B 面不切；无切边组放刀补组&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="360" y="344" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p07-n12-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;压板：定位孔决定 A / B 切&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;无定位孔 → A 面切边&lt;br&gt;有定位孔 → A 面打孔锁螺丝；A 切会与毛坯分开，改 B 面切&lt;br&gt;压板必须选校准板，否则三夹程序组创建不了、外形倒角漏&lt;br&gt;切边刀 D6.0/D10；外形切边最后做&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="880" y="344" width="720" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p07-n13-t" value="&lt;b&gt;三、内轮廓：无色走普通，有色走刀补&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="520" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p07-n14-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;无色内轮廓：GetBodyShadowOutline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;粗：D10粗 0.7→D6 0.7→D4 0.5→D3 0.3→D2 0.3→D1.5 0.2→D1 0.1；底 0.2&lt;br&gt;精：D10粗 0.1/0.4→D10平 0/0.4→D6→D4→D3→D2→D1.5→D1→D10平 0/0.2&lt;br&gt;按 Z 范围分组；每级带上一把参考刀；开放两平行线/极小圆弧删&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="554" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p07-n15-mech" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;有色内轮廓：GetBodyShadowOutlineColor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;粗：同无色，但单独一组，不做“移除剩余”&lt;br&gt;精：走 CuttCompen 刀补组，注册刀补号；侧 0.1 / 底 0.2~0.4&lt;br&gt;颜色内轮廓不并普通内轮廓；刀补号按颜色/组分配&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#8A6FB0;strokeWidth=1.2;fontColor=#402E5C;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="820" y="554" width="780" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p07-n16-t" value="&lt;b&gt;四、刀补 / 切边 / 排序&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=13;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="750" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p07-n17-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;刀补&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;有色内轮廓 → CuttCompen&lt;br&gt;外轮廓 A/B 切 → Trimming&lt;br&gt;虎钳无切边组 → 放 CuttCompen&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="784" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p07-n18-param" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;切边排序&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A 切：无定位孔；B 切：有定位孔&lt;br&gt;外形切边最后做；二夹切边最后&lt;br&gt;D2 刀后置&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF8F0;strokeColor=#5B9B6A;strokeWidth=1.2;fontColor=#24512F;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" parent="1" vertex="1">
          <mxGeometry x="560" y="784" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p07-n19-case" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;边界 / 清理&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;开放轮廓两平行线 → 删&lt;br&gt;极小圆弧 R＜0.05 → 删&lt;br&gt;空刀路删除；压板底留 0.2 给二夹&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C0504D;strokeWidth=1.2;fontColor=#7A2620;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;dashed=1;dashPattern=5 3;" parent="1" vertex="1">
          <mxGeometry x="1080" y="784" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p07-n20-t" value="&lt;b&gt;五、外轮廓 A/B 切决策表&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=12;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="930" width="1600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p07-n21-cell" value="装夹" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="964" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p07-n22-cell" value="定位孔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="240" y="964" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p07-n23-cell" value="A 面切边" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="460" y="964" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p07-n24-cell" value="B 面切边" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="700" y="964" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p07-n25-cell" value="说明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="964" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p07-n26-cell" value="虎钳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
          <mxGeometry x="40" y="998" width="200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p07-n27-cell" value="不适用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAF7;strokeColor=#D9E2F3;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#1F3A5F;" parent="1" vertex="1">
